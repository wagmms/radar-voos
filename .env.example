# Configurações do Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Pool de Chaves SerpAPI (separadas por vírgula)
SERPAPI_KEYS=sua_chave_serpapi_1,sua_chave_serpapi_2

# Limites de Consulta SerpAPI
LIMITE_DIARIO_POR_CHAVE=8
LIMITE_MENSAL_POR_CHAVE=250

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui
TELEGRAM_POLLING=true

# Notificações e Limiares
GATILHO_QUEDA_RELAMPAGO_PCT=15
FEED_PROMOCOES_URL=https://www.melhoresdestinos.com.br/feed
SCAN_INTERVAL_MINUTES=8
DB_PATH=./data/radar_voos.sqlite

# Two-Way Sync GitHub
GITHUB_TOKEN=seu_github_token_aqui
GITHUB_REPO=wagmms/radar-voos
GITHUB_BRANCH=main
